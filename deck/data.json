  "quotes": {
    "평론가": [
      {
        "media": "씨네21",
        "author": "정재현",
        "score": "8",
        "text": "'비키지 않는 무릎'으로 자유에 협력하고 대항하다."
      },
      {
        "media": "씨네21",
        "author": "조현나",
        "score": "8",
        "text": "진실과 애정으로도 포용할 수 없는 것에 관하여."
      },
      {
        "media": "씨네21",
        "author": "이자연",
        "score": "8",
        "text": "이토록 모순적인 삶, 그렇기에 가치 있는 생(生)."
      },
      {
        "media": "씨네21",
        "author": "이우빈",
        "score": "8",
        "text": "이 세상을 사랑하기란 정말 불가능한 것일지."
      }
    ],
    "일반 관객": [
      {
        "media": "왓챠피디아",
        "author": "깻잎케이크",
        "score": "4.5",
        "text": "가능하다고 믿는 사랑."
      },
      {
        "media": "왓챠피디아",
        "author": "굿펠라즈",
        "score": "4.5",
        "text": "두 가족·환경에서 느껴지는 감정이 칼날 같았다. 날 선 칼날이 무뎌질 때까지 부딪히다 예리함을 잃은 채 각자의 칼집으로 들어갔다."
      },
      {
        "media": "왓챠피디아",
        "author": "지구산책",
        "score": "4.0",
        "text": "카메라가 아니라 칼을 든 것처럼 보였다."
      },
      {
        "media": "왓챠피디아",
        "author": "이동후",
        "score": "4.0",
        "text": "가능한 사랑이 사랑일까."
      }
    ]
  },
